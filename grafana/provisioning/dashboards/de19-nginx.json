{
  "title": "DE19 - Nginx",
  "uid": "de19-nginx",
  "tags": ["de19", "nginx", "webserver"],
  "timezone": "Asia/Ho_Chi_Minh",
  "schemaVersion": 38,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Kết nối đang hoạt động",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "orange", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nginx_connections_active"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Tổng số kết nối được chấp nhận",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 }
            ]
          }
        }
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nginx_connections_accepted"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Tổng số kết nối đã xử lý",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 }
            ]
          }
        }
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nginx_connections_handled"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Tốc độ xử lý yêu cầu của Nginx (yêu cầu/giây)",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "showPoints": "auto",
            "pointSize": 5
          },
          "unit": "reqps"
        }
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(nginx_http_requests_total[1m])",
          "legendFormat": "Yêu cầu / giây"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Kết nối Đọc / Viết / Chờ đợi",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "showPoints": "auto",
            "pointSize": 5
          }
        }
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nginx_connections_reading",
          "legendFormat": "Đọc"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nginx_connections_writing",
          "legendFormat": "Viết"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nginx_connections_waiting",
          "legendFormat": "Đang chờ"
        }
      ]
    }
  ]
}
