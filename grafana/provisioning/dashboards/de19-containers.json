{
  "title": "DE19 - Containers",
  "uid": "de19-containers",
  "tags": ["de19", "containers", "docker"],
  "timezone": "Asia/Ho_Chi_Minh",
  "schemaVersion": 38,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Mức sử dụng CPU của container (%)",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "showPoints": "auto",
            "pointSize": 5
          },
          "unit": "percent"
        }
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(node_cpu_seconds_total{mode!=\"idle\"}[1m]) * 100",
          "legendFormat": "{{mode}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Mức sử dụng bộ nhớ của Container",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "showPoints": "auto",
            "pointSize": 5
          },
          "unit": "bytes"
        }
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "container_memory_usage_bytes",
          "legendFormat": "{{job}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
          "legendFormat": "used_memory"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Lưu lượng mạng nhận được (Rx)",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "showPoints": "auto",
            "pointSize": 5
          },
          "unit": "binBps"
        }
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(node_network_receive_bytes_total{device!~\"lo\"}[1m])",
          "legendFormat": "{{device}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Lưu lượng mạng được truyền tải (Tx)",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "showPoints": "auto",
            "pointSize": 5
          },
          "unit": "binBps"
        }
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(node_network_transmit_bytes_total{device!~\"lo\"}[1m])",
          "legendFormat": "{{device}}"
        }
      ]
    }
  ]
}
