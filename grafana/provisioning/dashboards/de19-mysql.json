{
  "title": "DE19 - MySQL",
  "uid": "de19-mysql",
  "tags": ["de19", "mysql", "database"],
  "timezone": "Asia/Ho_Chi_Minh",
  "schemaVersion": 38,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Số câu hỏi/truy vấn mỗi giây",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "showPoints": "auto",
            "pointSize": 5
          },
          "color": { "fixedColor": "green", "mode": "fixed" }
        }
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(mysql_global_status_queries[1m])",
          "legendFormat": "Truy vấn/giây"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Khách hàng hiện đang kết nối",
      "gridPos": { "h": 9, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "green", "mode": "fixed" }
        }
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "mysql_global_status_threads_connected"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Các luồng đang chạy",
      "gridPos": { "h": 9, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "green", "mode": "fixed" }
        }
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "mysql_global_status_threads_running"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Kích thước và mức sử dụng bộ nhớ đệm InnoDB",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "showPoints": "auto",
            "pointSize": 5
          },
          "unit": "bytes"
        }
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "mysql_global_status_innodb_buffer_pool_bytes_data",
          "legendFormat": "Byte đã dùng"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "mysql_global_status_innodb_buffer_pool_bytes_total",
          "legendFormat": "Tổng kích thước vùng đệm"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tổng tốc độ kết nối MySQL",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "showPoints": "auto",
            "pointSize": 5
          },
          "color": { "fixedColor": "green", "mode": "fixed" }
        }
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(mysql_global_status_connections[1m])",
          "legendFormat": "Kết nối/giây"
        }
      ]
    }
  ]
}
