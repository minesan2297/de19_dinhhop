{
  "__inputs": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus" },
    { "name": "DS_LOKI",       "label": "Loki",       "type": "datasource", "pluginId": "loki" }
  ],
  "title": "DE19 – News Website Monitor",
  "uid":   "de19-monitor",
  "tags":  ["de19", "news", "wordpress"],
  "timezone": "Asia/Ho_Chi_Minh",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [

    { "id": 1, "type": "stat", "gridPos": {"h":4,"w":4,"x":0,"y":0},
      "title": "CPU Usage",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "mode": "absolute", "steps": [
            {"color":"green","value":0},{"color":"yellow","value":60},{"color":"red","value":80}
          ]}
        }
      },
      "targets": [{
        "datasource": {"type":"prometheus","uid":"${DS_PROMETHEUS}"},
        "expr": "100 - (avg(irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
        "legendFormat": "CPU %"
      }]
    },

    { "id": 2, "type": "stat", "gridPos": {"h":4,"w":4,"x":4,"y":0},
      "title": "RAM Usage",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "mode": "absolute", "steps": [
            {"color":"green","value":0},{"color":"yellow","value":70},{"color":"red","value":85}
          ]}
        }
      },
      "targets": [{
        "datasource": {"type":"prometheus","uid":"${DS_PROMETHEUS}"},
        "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
        "legendFormat": "RAM %"
      }]
    },

    { "id": 3, "type": "stat", "gridPos": {"h":4,"w":4,"x":8,"y":0},
      "title": "Disk Usage",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "mode": "absolute", "steps": [
            {"color":"green","value":0},{"color":"yellow","value":70},{"color":"red","value":80}
          ]}
        }
      },
      "targets": [{
        "datasource": {"type":"prometheus","uid":"${DS_PROMETHEUS}"},
        "expr": "(1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}) * 100",
        "legendFormat": "Disk %"
      }]
    },

    { "id": 4, "type": "stat", "gridPos": {"h":4,"w":4,"x":12,"y":0},
      "title": "Containers Running",
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [
            {"color":"red","value":0},{"color":"yellow","value":5},{"color":"green","value":8}
          ]}
        }
      },
      "targets": [{
        "datasource": {"type":"prometheus","uid":"${DS_PROMETHEUS}"},
        "expr": "count(container_last_seen{name=~\"de19_.*\"})",
        "legendFormat": "Containers"
      }]
    },

    { "id": 5, "type": "stat", "gridPos": {"h":4,"w":4,"x":16,"y":0},
      "title": "Uptime",
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{
        "datasource": {"type":"prometheus","uid":"${DS_PROMETHEUS}"},
        "expr": "node_time_seconds - node_boot_time_seconds",
        "legendFormat": "Uptime"
      }]
    },

    { "id": 6, "type": "stat", "gridPos": {"h":4,"w":4,"x":20,"y":0},
      "title": "Network In (1m)",
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "targets": [{
        "datasource": {"type":"prometheus","uid":"${DS_PROMETHEUS}"},
        "expr": "sum(irate(node_network_receive_bytes_total{device!=\"lo\"}[1m]))",
        "legendFormat": "Network In"
      }]
    },

    { "id": 10, "type": "timeseries", "gridPos": {"h":8,"w":12,"x":0,"y":4},
      "title": "CPU & RAM theo thời gian",
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "targets": [
        {
          "datasource": {"type":"prometheus","uid":"${DS_PROMETHEUS}"},
          "expr": "100 - (avg(irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "CPU %"
        },
        {
          "datasource": {"type":"prometheus","uid":"${DS_PROMETHEUS}"},
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "legendFormat": "RAM %"
        }
      ]
    },

    { "id": 11, "type": "timeseries", "gridPos": {"h":8,"w":12,"x":12,"y":4},
      "title": "Network I/O",
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "targets": [
        {
          "datasource": {"type":"prometheus","uid":"${DS_PROMETHEUS}"},
          "expr": "sum(irate(node_network_receive_bytes_total{device!=\"lo\"}[1m]))",
          "legendFormat": "↓ Nhận"
        },
        {
          "datasource": {"type":"prometheus","uid":"${DS_PROMETHEUS}"},
          "expr": "sum(irate(node_network_transmit_bytes_total{device!=\"lo\"}[1m]))",
          "legendFormat": "↑ Gửi"
        }
      ]
    },

    { "id": 20, "type": "logs", "gridPos": {"h":10,"w":24,"x":0,"y":12},
      "title": "📋 Nginx Access Logs (LogQL)",
      "options": {
        "showTime": true,
        "showLabels": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true
      },
      "targets": [{
        "datasource": {"type":"loki","uid":"${DS_LOKI}"},
        "expr": "{job=\"nginx\"}",
        "legendFormat": ""
      }]
    },

    { "id": 21, "type": "logs", "gridPos": {"h":10,"w":24,"x":0,"y":22},
      "title": "🐳 WordPress Container Logs",
      "options": { "showTime": true, "sortOrder": "Descending" },
      "targets": [{
        "datasource": {"type":"loki","uid":"${DS_LOKI}"},
        "expr": "{container=\"de19_wordpress\"}",
        "legendFormat": ""
      }]
    },

    { "id": 30, "type": "table", "gridPos": {"h":8,"w":12,"x":0,"y":32},
      "title": "Container CPU Usage",
      "targets": [{
        "datasource": {"type":"prometheus","uid":"${DS_PROMETHEUS}"},
        "expr": "sum by (name) (irate(container_cpu_usage_seconds_total{name=~\"de19_.*\"}[1m])) * 100",
        "legendFormat": "{{name}}",
        "instant": true
      }]
    },

    { "id": 31, "type": "table", "gridPos": {"h":8,"w":12,"x":12,"y":32},
      "title": "Container RAM Usage",
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [{
        "datasource": {"type":"prometheus","uid":"${DS_PROMETHEUS}"},
        "expr": "sum by (name) (container_memory_usage_bytes{name=~\"de19_.*\"})",
        "legendFormat": "{{name}}",
        "instant": true
      }]
    }

  ]
}
